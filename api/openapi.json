          },
          "memberCount": {
            "type": "integer"
          },
          "taskCounts": {
            "type": "object",
            "properties": {
              "TODO": {
                "type": "integer"
              },
              "IN_PROGRESS": {
                "type": "integer"
              },
              "DONE": {
                "type": "integer"
              }
