# Base URL of the Nest API (server-side only, never exposed to the browser)
API_URL=http://127.0.0.1:3333

# Optional organisation name shown under the wordmark (leave empty to hide)
NEXT_PUBLIC_ORG_NAME=

# Set to true when the data is synthetic: shows a "Dados de demonstração" chip in the shell and on sign-in/sign-up
NEXT_PUBLIC_DEMO_DATA=
